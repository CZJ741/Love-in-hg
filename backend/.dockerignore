# ============================================================
# .dockerignore — 排除不需要打包进镜像的文件
# 原则：镜像只含运行时必需文件，排除缓存/测试/IDE配置/敏感信息
# ============================================================

# ---------- Python 缓存与虚拟环境 ----------
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.Python

# ---------- 测试与临时文件 ----------
test_fix.py
verify.py
reset.py
*.tmp
*.log

# ---------- IDE 与编辑器配置 ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- Git ----------
.git/
.gitignore

# ---------- 敏感文件（绝对不进镜像） ----------
.env
.env.local
*.pem
*.key

# ---------- Docker 自身 ----------
Dockerfile
.dockerignore
docker-compose*.yml

# ---------- 其他 ----------
*.md
docs/
seed/
backend.zip
