# 后端环境变量配置
# 复制此文件为 .env 并修改

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=love_hg

INIT_DATA_PASSWORD=admin123

# 微信小程序 / 微信支付配置（可暂时留空）
WX_APP_ID=
# 小程序 Secret（微信公众平台 -> 开发管理 -> 开发设置），code2session 换取 openid 必填
WX_APP_SECRET=
WX_MCH_ID=
WX_PAY_API_KEY=
WX_PAY_NOTIFY_URL=https://yourdomain.com/api/membership/notify
WX_PAY_MOCK_ENABLED=true

