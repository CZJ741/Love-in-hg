/* app.wxss */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 通用按钮 */
.btn-primary {
  background-color: #e74c3c;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

.btn-primary:active {
  background-color: #c0392b;
}

.btn-outline {
  background-color: #fff;
  color: #e74c3c;
  border: 1rpx solid #e74c3c;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 12rpx 24rpx;
  text-align: center;
}

/* 卡片 */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.tag-pink {
  background-color: #fce4ec;
  color: #e74c3c;
}

.tag-blue {
  background-color: #e3f2fd;
  color: #2196f3;
}

.tag-green {
  background-color: #e8f5e9;
  color: #4caf50;
}

.tag-orange {
  background-color: #fff3e0;
  color: #ff9800;
}

/* 筛选项 */
.filter-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  background-color: #fff;
  border: 1rpx solid #ddd;
  color: #666;
}

.filter-tag.active {
  background-color: #e74c3c;
  border-color: #e74c3c;
  color: #fff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-state .icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background-color: #eee;
  margin: 20rpx 0;
}

/* flex 布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}
