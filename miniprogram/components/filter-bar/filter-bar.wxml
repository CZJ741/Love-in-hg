<!-- components/filter-bar/filter-bar.wxml -->
<view class="filter-bar">
  <!-- 基础筛选主栏（直接呈现三大基础项下拉菜单 + 高级筛选展开按钮） -->
  <view class="filter-main-bar">
    <view class="dropdown-group">
      <!-- 1. 性别下拉选择 -->
      <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
        <view class="dropdown-trigger {{genderIndex > 0 ? 'active' : ''}}">
          <text class="dropdown-title">{{genderIndex > 0 ? genderOptions[genderIndex] : '性别'}}</text>
          <text class="dropdown-arrow">▼</text>
        </view>
      </picker>

      <!-- 2. 住房下拉选择 -->
      <picker mode="selector" range="{{housingOptions}}" value="{{housingIndex}}" bindchange="onHousingChange">
        <view class="dropdown-trigger {{housingIndex > 0 ? 'active' : ''}}">
          <text class="dropdown-title">{{housingIndex > 0 ? housingOptions[housingIndex] + '房' : '住房'}}</text>
          <text class="dropdown-arrow">▼</text>
        </view>
      </picker>

      <!-- 3. 年龄下拉选择 -->
      <picker mode="selector" range="{{ageOptions}}" value="{{ageIndex}}" bindchange="onAgeChange">
        <view class="dropdown-trigger {{ageIndex > 0 ? 'active' : ''}}">
          <text class="dropdown-title">{{ageIndex > 0 ? ageOptions[ageIndex] : '年龄'}}</text>
          <text class="dropdown-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 右侧高级筛选触发入口 -->
    <view class="advanced-btn {{expanded ? 'open' : ''}}" bindtap="onToggleExpand">
      <text class="advanced-text">高级筛选</text>
      <text class="advanced-arrow">{{expanded ? '▲' : '▼'}}</text>
      <view class="active-dot" wx:if="{{activeCount > 0}}"></view>
    </view>
  </view>

  <!-- 高级筛选面板（展开后呈现会员专享进阶维度） -->
  <view class="advanced-panel" wx:if="{{expanded}}">
    <view class="panel-header">
      <view class="panel-title-left">
        <text class="vip-tag">👑 会员专享</text>
      </view>
    </view>

    <!-- 身高 -->
    <view class="filter-row">
      <text class="row-label">身高 (cm)</text>
      <view class="option-flow">
        <view class="opt-chip {{!tempFilter.heightRange ? 'selected' : ''}}" data-key="heightRange" data-value="" bindtap="onMemberFilter">不限</view>
        <view class="opt-chip {{tempFilter.heightRange === '150-160' ? 'selected' : ''}}" data-key="heightRange" data-value="150-160" bindtap="onMemberFilter">150-160</view>
        <view class="opt-chip {{tempFilter.heightRange === '160-170' ? 'selected' : ''}}" data-key="heightRange" data-value="160-170" bindtap="onMemberFilter">160-170</view>
        <view class="opt-chip {{tempFilter.heightRange === '170-180' ? 'selected' : ''}}" data-key="heightRange" data-value="170-180" bindtap="onMemberFilter">170-180</view>
        <view class="opt-chip {{tempFilter.heightRange === '180-190' ? 'selected' : ''}}" data-key="heightRange" data-value="180-190" bindtap="onMemberFilter">180-190</view>
        <view class="opt-chip {{tempFilter.heightRange === '190-220' ? 'selected' : ''}}" data-key="heightRange" data-value="190-220" bindtap="onMemberFilter">190以上</view>
      </view>
    </view>

    <!-- 体重 -->
    <view class="filter-row">
      <text class="row-label">体重 (kg)</text>
      <view class="option-flow">
        <view class="opt-chip {{!tempFilter.weightRange ? 'selected' : ''}}" data-key="weightRange" data-value="" bindtap="onMemberFilter">不限</view>
        <view class="opt-chip {{tempFilter.weightRange === '40-50' ? 'selected' : ''}}" data-key="weightRange" data-value="40-50" bindtap="onMemberFilter">40-50</view>
        <view class="opt-chip {{tempFilter.weightRange === '50-60' ? 'selected' : ''}}" data-key="weightRange" data-value="50-60" bindtap="onMemberFilter">50-60</view>
        <view class="opt-chip {{tempFilter.weightRange === '60-70' ? 'selected' : ''}}" data-key="weightRange" data-value="60-70" bindtap="onMemberFilter">60-70</view>
        <view class="opt-chip {{tempFilter.weightRange === '70-80' ? 'selected' : ''}}" data-key="weightRange" data-value="70-80" bindtap="onMemberFilter">70-80</view>
        <view class="opt-chip {{tempFilter.weightRange === '80-120' ? 'selected' : ''}}" data-key="weightRange" data-value="80-120" bindtap="onMemberFilter">80以上</view>
      </view>
    </view>

    <!-- 体制内 -->
    <view class="filter-row">
      <text class="row-label">体制内单位</text>
      <view class="option-flow">
        <view class="opt-chip {{tempFilter.isPublicSector === undefined ? 'selected' : ''}}" data-key="isPublicSector" data-value="" bindtap="onMemberFilter">不限</view>
        <view class="opt-chip {{tempFilter.isPublicSector === true ? 'selected' : ''}}" data-key="isPublicSector" data-value="{{true}}" bindtap="onMemberFilter">体制内</view>
        <view class="opt-chip {{tempFilter.isPublicSector === false ? 'selected' : ''}}" data-key="isPublicSector" data-value="{{false}}" bindtap="onMemberFilter">非体制内</view>
      </view>
    </view>

    <!-- 收入 -->
    <view class="filter-row">
      <text class="row-label">收入水平</text>
      <view class="option-flow">
        <view class="opt-chip {{!tempFilter.income ? 'selected' : ''}}" data-key="income" data-value="" bindtap="onMemberFilter">不限</view>
        <view class="opt-chip {{tempFilter.income === '3万以下' ? 'selected' : ''}}" data-key="income" data-value="3万以下" bindtap="onMemberFilter">3万以下</view>
        <view class="opt-chip {{tempFilter.income === '3-5万' ? 'selected' : ''}}" data-key="income" data-value="3-5万" bindtap="onMemberFilter">3-5万</view>
        <view class="opt-chip {{tempFilter.income === '5-10万' ? 'selected' : ''}}" data-key="income" data-value="5-10万" bindtap="onMemberFilter">5-10万</view>
        <view class="opt-chip {{tempFilter.income === '10-20万' ? 'selected' : ''}}" data-key="income" data-value="10-20万" bindtap="onMemberFilter">10-20万</view>
        <view class="opt-chip {{tempFilter.income === '20-30万' ? 'selected' : ''}}" data-key="income" data-value="20-30万" bindtap="onMemberFilter">20-30万</view>
        <view class="opt-chip {{tempFilter.income === '30-50万' ? 'selected' : ''}}" data-key="income" data-value="30-50万" bindtap="onMemberFilter">30-50万</view>
        <view class="opt-chip {{tempFilter.income === '50万以上' ? 'selected' : ''}}" data-key="income" data-value="50万以上" bindtap="onMemberFilter">50万以上</view>
      </view>
    </view>

    <!-- 面板底部操作栏 -->
    <view class="panel-bottom-actions">
      <view class="btn-panel-reset" bindtap="onReset">重置</view>
      <view class="btn-panel-confirm" bindtap="onConfirm">应用</view>
    </view>
  </view>
</view>
