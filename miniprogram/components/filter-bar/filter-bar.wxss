/* components/filter-bar/filter-bar.wxss */

.filter-bar {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

/* 基础筛选主栏 */
.filter-main-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 20rpx;
}

/* 下拉菜单分组 */
.dropdown-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.dropdown-trigger {
  display: flex;
  align-items: center;
  background: #f8fafc;
  padding: 10rpx 18rpx;
  border-radius: 28rpx;
  border: 1rpx solid #e2e8f0;
  transition: all 0.2s ease;
}

.dropdown-trigger.active {
  background: #fef2f2;
  border-color: #fca5a5;
}

.dropdown-title {
  font-size: 24rpx;
  color: #475569;
  font-weight: 500;
}

.dropdown-trigger.active .dropdown-title {
  color: #e74c3c;
  font-weight: 600;
}

.dropdown-arrow {
  font-size: 16rpx;
  color: #94a3b8;
  margin-left: 6rpx;
}

.dropdown-trigger.active .dropdown-arrow {
  color: #e74c3c;
}

/* 右侧高级筛选入口 */
.advanced-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  position: relative;
}

.advanced-text {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.advanced-arrow {
  font-size: 16rpx;
  color: #94a3b8;
  margin-left: 6rpx;
}

.advanced-btn.open .advanced-text,
.advanced-btn.open .advanced-arrow {
  color: #e74c3c;
  font-weight: 600;
}

.active-dot {
  position: absolute;
  top: 8rpx;
  right: 6rpx;
  width: 10rpx;
  height: 10rpx;
  background: #e74c3c;
  border-radius: 50%;
}

/* 高级进阶筛选面板 */
.advanced-panel {
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f1f5f9;
  background: #fafafa;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.panel-title-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.panel-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.vip-tag {
  font-size: 20rpx;
  background: linear-gradient(135deg, #fff7e6, #ffe8b3);
  color: #d48806;
  border: 1rpx solid #ffd591;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.vip-tip {
  font-size: 22rpx;
  color: #e74c3c;
}

/* 行项与选项流 */
.filter-row {
  margin-bottom: 20rpx;
}

.row-label {
  font-size: 23rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  display: block;
}

.option-flow {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.opt-chip {
  font-size: 23rpx;
  color: #475569;
  background: #ffffff;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e2e8f0;
  transition: all 0.15s ease;
}

.opt-chip.selected {
  background: #e74c3c;
  color: #ffffff;
  border-color: #e74c3c;
  font-weight: 500;
}

/* 底部操作条 */
.panel-bottom-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
  margin-top: 10rpx;
  border-top: 1rpx solid #e2e8f0;
}

.btn-panel-reset {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #64748b;
  padding: 14rpx 0;
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
}

.btn-panel-confirm {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff5e62, #ff9966);
  padding: 14rpx 0;
  border-radius: 12rpx;
  font-weight: 600;
}
