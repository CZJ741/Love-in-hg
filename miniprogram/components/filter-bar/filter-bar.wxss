/* components/filter-bar/filter-bar.wxss */
.filter-bar {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 头部 */
.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}

.filter-header-left {
  display: flex;
  align-items: center;
}

.filter-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.filter-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.filter-badge {
  margin-left: 10rpx;
  background: #e74c3c;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

.filter-header-right {
  display: flex;
  align-items: center;
}

.filter-toggle {
  font-size: 24rpx;
  color: #999;
}

/* 已选条件标签 */
.active-tags {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx 16rpx;
}

.active-tag {
  font-size: 22rpx;
  color: #e74c3c;
  background: #fef0f0;
  border: 1rpx solid #fde2e2;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
}

/* 筛选面板 */
.filter-panel {
  padding: 0 24rpx 8rpx;
  border-top: 1rpx solid #f5f5f5;
}

.filter-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #fafafa;
}

.filter-row:last-of-type {
  border-bottom: none;
}

.filter-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
  display: block;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
}

.option-item {
  font-size: 24rpx;
  color: #666;
  background: #f8f8f8;
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  transition: all 0.2s;
}

.option-item.active {
  background: #e74c3c;
  color: #fff;
  font-weight: 500;
}

/* 操作按钮 */
.filter-actions {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0 8rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn-reset {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  padding: 16rpx 0;
  margin-right: 16rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.btn-confirm {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: #e74c3c;
  padding: 16rpx 0;
  border-radius: 8rpx;
  font-weight: 500;
}
