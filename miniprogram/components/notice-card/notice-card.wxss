/* components/notice-card/notice-card.wxss */
.notice-card.card {
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  padding: 28rpx 24rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.notice-card.card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 顶部性别色装饰条 */
.notice-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
}

.notice-card.gender-male::before {
  background: linear-gradient(90deg, #64b5f6, #2196f3);
}

.notice-card.gender-female::before {
  background: linear-gradient(90deg, #f48fb1, #e74c3c);
}

.card-header {
  margin-bottom: 18rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
  margin-right: 12rpx;
}

.gender {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 8rpx;
}

.gender.male {
  background-color: #e3f2fd;
  color: #2196f3;
}

.gender.female {
  background-color: #fce4ec;
  color: #e74c3c;
}

.age {
  font-size: 26rpx;
  color: #888;
}

.height {
  font-size: 24rpx;
  color: #999;
  background: #f7f7f7;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.card-body {
  margin-bottom: 12rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 24rpx;
  color: #999;
  min-width: 88rpx;
  margin-right: 12rpx;
  line-height: 1.5;
  position: relative;
  padding-left: 16rpx;
  flex-shrink: 0;
}

.label::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #f2b8b8;
}

.sector-row .label::before {
  background: #e74c3c;
}

.value {
  font-size: 26rpx;
  color: #333;
  margin-right: 12rpx;
  flex: 1;
  word-break: break-all;
  line-height: 1.5;
}

/* 体制内徽章 */
.sector-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #e74c3c, #f37055);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.card-footer {
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.phone {
  font-size: 30rpx;
  color: #e74c3c;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.phone-action {
  border-top: none;
  padding-top: 4rpx;
}

.phone-hint {
  display: block;
  text-align: center;
  padding: 16rpx 0;
  color: #e74c3c;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.card-remark {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fdf6f4;
  border-radius: 12rpx;
  border-left: 4rpx solid #f2b8b8;
}

.remark-label {
  display: inline-block;
  font-size: 22rpx;
  color: #e74c3c;
  font-weight: 600;
  margin-right: 8rpx;
  margin-bottom: 6rpx;
}

.remark-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  word-break: break-all;
}
