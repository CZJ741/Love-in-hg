/* components/notice-card/notice-card.wxss */

.notice-card {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

/* 顶部主题色饰条 */
.card-accent-bar {
  height: 6rpx;
  width: 100%;
}

.notice-card.gender-male .card-accent-bar {
  background: linear-gradient(90deg, #3498db, #5dade2);
}

.notice-card.gender-female .card-accent-bar {
  background: linear-gradient(90deg, #e74c3c, #f1948a);
}

/* 头部卡片区 */
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 18rpx;
  border-bottom: 1rpx solid #f8f9fa;
}

.head-user {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
  letter-spacing: 0.5rpx;
}

/* 模糊处理：纯粹高斯模糊遮罩，不额外占位 */
.blur-content {
  filter: blur(12rpx);
  user-select: none;
  opacity: 0.65;
  display: inline-block;
}

/* 性别年龄组合徽章 */
.gender-age-tag {
  display: flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.tag-male {
  background: #ebf5fb;
  color: #2980b9;
}

.tag-female {
  background: #fdf2e9;
  color: #d35400;
}

.gender-icon {
  font-size: 24rpx;
  margin-right: 4rpx;
  font-weight: bold;
}

/* 发布人角标 */
.role-badge {
  font-size: 20rpx;
  color: #8c9ba5;
  background: #f4f6f8;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 核心信息排列表（单行列表设计） */
.card-info-list {
  padding: 12rpx 24rpx;
}

.info-cell {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx dashed #f2f4f7;
}

.info-cell:last-child {
  border-bottom: none;
}

.cell-label {
  width: 100rpx;
  font-size: 23rpx;
  color: #94a3b8;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.cell-val {
  flex: 1;
  font-size: 25rpx;
  color: #334155;
  font-weight: 500;
  word-break: break-all;
}

.font-num {
  font-weight: 600;
  color: #1e293b;
}

.font-highlight {
  color: #e67e22;
  font-weight: 600;
}

/* 标签小组件 */
.location-pill {
  display: inline-block;
  background: #f0fdf4;
  color: #16a34a;
  border: 1rpx solid #bbf7d0;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.sector-pill {
  display: inline-block;
  background: #fef2f2;
  color: #dc2626;
  border: 1rpx solid #fecaca;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
}

/* 备注引用框 */
.card-quote {
  margin: 14rpx 20rpx 18rpx;
  padding: 16rpx 20rpx;
  background: #fafaf9;
  border-left: 5rpx solid #e2e8f0;
  border-radius: 8rpx;
}

.quote-header {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 6rpx;
}

.quote-icon {
  font-size: 26rpx;
  color: #94a3b8;
  line-height: 1;
}

.quote-title {
  font-size: 21rpx;
  color: #64748b;
  font-weight: 600;
}

.quote-text {
  font-size: 23rpx;
  color: #475569;
  line-height: 1.6;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
}

/* 底部联系方式展示（我的启事） */
.card-footer-phone {
  padding: 16rpx 24rpx;
  background: #f8fafc;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #f1f5f9;
}

.phone-tag {
  font-size: 22rpx;
  color: #64748b;
}

.phone-number {
  font-size: 28rpx;
  color: #e74c3c;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 底部操作按钮栏（单行查看详情按钮） */
.card-footer-action {
  padding: 12rpx 20rpx 16rpx;
  display: flex;
}

.btn-action-pill {
  width: 100%;
  font-size: 26rpx;
  font-weight: 600;
  padding: 10rpx 0;
  line-height: 1.4;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  box-sizing: border-box;
}

.btn-action-pill:active {
  opacity: 0.6;
  transform: scale(0.98);
}

.action-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

/* 查看详情按钮（优雅温和珊瑚红链接风格） */
.btn-view-detail {
  color: #e11d48;
}

/* 照片展示专属弹窗 */
.photo-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 30rpx;
  backdrop-filter: blur(6px);
}

.photo-card {
  background: #ffffff;
  border-radius: 28rpx;
  width: 620rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25);
  animation: photoModalIn 0.2s ease-out;
}

@keyframes photoModalIn {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.photo-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.photo-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.photo-card-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 6rpx 12rpx;
  line-height: 1;
}

.photo-card-body {
  padding: 24rpx 32rpx 32rpx;
  max-height: 62vh;
  box-sizing: border-box;
}

.photo-gallery-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.gallery-img {
  width: 100%;
  height: 250rpx;
  border-radius: 14rpx;
  background: #f1f5f9;
}

.photo-hint-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 24rpx;
}

