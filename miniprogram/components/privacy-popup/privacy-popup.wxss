/* components/privacy-popup/privacy-popup.wxss */
.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

.privacy-dialog {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}

.privacy-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1e293b;
}

.privacy-body {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.6;
  margin-bottom: 36rpx;
}

.privacy-desc {
  color: #475569;
}

.privacy-link {
  color: #e74c3c;
  font-weight: 500;
  text-decoration: underline;
}

.privacy-footer {
  display: flex;
  gap: 20rpx;
}

.btn-privacy-disagree {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #f1f5f9;
  color: #64748b;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0;
  margin: 0 !important;
}

.btn-privacy-agree {
  flex: 1.3;
  height: 80rpx;
  line-height: 80rpx;
  background: #e74c3c;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0;
  margin: 0 !important;
}

.btn-privacy-agree::after,
.btn-privacy-disagree::after {
  border: none;
}
