/* pages/my/my.wxss */
.profile-card {
  padding: 40rpx 24rpx;
}

.profile-header {
  margin-bottom: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e74c3c;
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 34rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 4rpx;
}

.profile-phone {
  font-size: 24rpx;
  color: #999;
}

.membership-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.membership-badge.free {
  background: #f5f5f5;
  color: #999;
}
.membership-badge.member {
  background: #fff3e0;
  color: #ff9800;
}
.membership-badge.vip {
  background: #fce4ec;
  color: #e74c3c;
}

.profile-stats {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #e74c3c;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.login-hint {
  text-align: center;
}

.phone-login-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #2196f3;
  text-decoration: underline;
}

/* 会员卡片 */
.section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.member-cards {
  display: flex;
  justify-content: space-between;
}

.member-card {
  flex: 1;
  text-align: center;
  padding: 24rpx 12rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  margin: 0 6rpx;
  position: relative;
}

.member-card.current {
  border-color: #e74c3c;
  background: #fff5f5;
}

.member-name {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 6rpx;
}

.member-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
}

.member-price {
  font-size: 26rpx;
  color: #e74c3c;
  font-weight: bold;
  display: block;
}

.member-tag {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  background: #e74c3c;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 0 12rpx 0 8rpx;
}

.member-buy {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #e74c3c;
  border: 1rpx solid #e74c3c;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}

.member-expire {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
}

/* 配额行 */
.quota-row {
  padding: 12rpx 0;
  font-size: 26rpx;
}

.quota-value {
  color: #e74c3c;
  font-weight: bold;
}

.logout-btn {
  width: 100%;
  margin-top: 40rpx;
  margin-bottom: 60rpx;
}

/* 账号与隐私设置 */
.account-section {
  padding: 0 24rpx;
}

.account-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #333;
}

.account-item:last-child {
  border-bottom: none;
}

.account-item:active {
  opacity: 0.7;
}

.account-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.account-phone {
  font-size: 26rpx;
  color: #2196f3;
}

.danger-text {
  color: #e74c3c;
}

/* 手动登录弹窗 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.login-card {
  width: 560rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 50rpx 40rpx;
  text-align: center;
}
.login-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}
.login-input {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 18rpx;
  font-size: 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.login-btn {
  width: 100%;
  margin-bottom: 16rpx;
}
.login-cancel {
  font-size: 26rpx;
  color: #999;
}
