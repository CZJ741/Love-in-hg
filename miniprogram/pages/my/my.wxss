/* pages/my/my.wxss */
.profile-card {
  padding: 40rpx 24rpx;
}

.profile-header {
  margin-bottom: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e74c3c;
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 34rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 4rpx;
}

.profile-phone {
  font-size: 24rpx;
  color: #999;
}

.membership-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.membership-badge.free {
  background: #f5f5f5;
  color: #999;
}
.membership-badge.member {
  background: #fff3e0;
  color: #ff9800;
}
.membership-badge.vip {
  background: #fce4ec;
  color: #e74c3c;
}

.profile-stats {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #e74c3c;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.login-hint {
  text-align: center;
}

.phone-login-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #2196f3;
  text-decoration: underline;
}

/* 会员卡片 */
.section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.member-cards {
  display: flex;
  justify-content: space-between;
}

.member-card {
  flex: 1;
  text-align: center;
  padding: 24rpx 12rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  margin: 0 6rpx;
  position: relative;
}

.member-card.current {
  border-color: #e74c3c;
  background: #fff5f5;
}

.member-name {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 6rpx;
}

.member-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
}

.member-price {
  font-size: 26rpx;
  color: #e74c3c;
  font-weight: bold;
  display: block;
}

.member-tag {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  background: #e74c3c;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 0 12rpx 0 8rpx;
}

.member-buy {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #e74c3c;
  border: 1rpx solid #e74c3c;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}

.member-expire {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
}

/* 配额行 */
.quota-row {
  padding: 12rpx 0;
  font-size: 26rpx;
}

.quota-value {
  color: #e74c3c;
  font-weight: bold;
}

.logout-btn {
  width: 100%;
  margin-top: 40rpx;
  margin-bottom: 60rpx;
}

/* 账号与隐私设置 */
.account-section {
  padding: 0 24rpx;
}

.account-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #333;
}

.account-item:last-child {
  border-bottom: none;
}

.account-item:active {
  opacity: 0.7;
}

.account-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.account-phone {
  font-size: 26rpx;
  color: #2196f3;
}

.danger-text {
  color: #e74c3c;
}

/* 登录/注册弹窗 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.login-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 44rpx 40rpx;
  width: 580rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
}

.login-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

/* 顶部简洁 Tab */
.auth-tabs {
  display: flex;
  gap: 32rpx;
}

.auth-tab {
  font-size: 32rpx;
  font-weight: 500;
  color: #999;
  position: relative;
  padding-bottom: 8rpx;
}

.auth-tab.active {
  color: #333;
  font-weight: bold;
}

.auth-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 4rpx;
  background: #e74c3c;
  border-radius: 2rpx;
}

.login-close {
  font-size: 36rpx;
  color: #bbb;
  padding: 0 8rpx;
  line-height: 1;
}

.login-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.login-input {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  min-height: 84rpx;
  line-height: normal;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 28rpx;
  background: #fafafa;
}

.login-input:focus {
  border-color: #e74c3c;
  background: #fff;
}

.login-btn {
  width: 100% !important;
  border-radius: 12rpx;
}

/* 验证码输入行 */
.verify-code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 28rpx;
}

.code-input {
  flex: 1;
  margin-bottom: 0 !important;
}

.btn-send-code {
  width: 200rpx !important;
  height: 84rpx;
  line-height: 84rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #e74c3c;
  padding: 0;
  text-align: center;
  margin: 0 !important;
  box-sizing: border-box;
}

.btn-send-code.disabled {
  background: #f1f5f9;
  color: #94a3b8;
  border-color: #e2e8f0;
}

/* 注销专用弹窗样式 */
.delete-card {
  border-top: 6rpx solid #e74c3c;
}

.delete-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #e74c3c;
}

.delete-warning-box {
  background: #fff5f5;
  border: 2rpx solid #fed7d7;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.delete-warning-text {
  font-size: 26rpx;
  color: #c53030;
  line-height: 1.5;
}

.delete-phone-tip {
  font-size: 26rpx;
  color: #4a5568;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.highlight-phone {
  font-weight: bold;
  color: #2d3748;
}

.delete-btn-group {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.delete-cancel-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  padding: 0;
  margin: 0 !important;
}

.delete-confirm-btn {
  flex: 1.4;
  height: 84rpx;
  line-height: 84rpx;
  background: #e74c3c;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  padding: 0;
  margin: 0 !important;
}

.delete-confirm-btn::after {
  border: none;
}

/* iOS 合规提示栏 */
.ios-compliance-banner {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}

.ios-banner-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ios-compliance-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.ios-compliance-text {
  font-size: 25rpx;
  color: #64748b;
  line-height: 1.5;
}

.btn-copy-pay-link {
  width: 100% !important;
  height: 72rpx;
  line-height: 72rpx;
  background: #ffffff;
  color: #e74c3c;
  border: 2rpx solid #e74c3c;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0;
  margin: 8rpx 0 0 !important;
}

.btn-copy-pay-link:active {
  background: #fff5f5;
}



