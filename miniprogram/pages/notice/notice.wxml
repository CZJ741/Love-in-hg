<!-- pages/notice/notice.wxml -->
<view class="container">
  <!-- 登录提示引导条（未登录时吸顶提示，点击直接唤起登录弹窗） -->
  <view class="unlogin-banner" wx:if="{{!isLoggedIn}}" bindtap="onOpenLoginModal">
    <view class="banner-left">
      <text class="banner-icon">🔒</text>
      <text class="banner-text">您当前处于访客模式，登录后解锁全部照片与联系方式</text>
    </view>
    <text class="banner-btn">去登录</text>
  </view>

  <!-- 登录弹窗（仅在需要登录时按需弹出，不再全屏阻断） -->
  <view class="login-modal" wx:if="{{showLoginModal}}" bindtap="onCloseLoginModal">
    <view class="login-card" catchtap="stopBubble">
      <view class="login-card-head">
        <text class="login-title">登录相亲角</text>
        <text class="login-close" bindtap="onCloseLoginModal">✕</text>
      </view>
      <view class="login-desc">登录后可查看完整姓名、清晰照片与联系方式</view>
      <input class="login-input" type="number" maxlength="11" placeholder="请输入手机号码" value="{{loginPhone}}" bindinput="onPhoneInput" />
      <button class="btn-primary login-btn" bindtap="onLogin" loading="{{loggingIn}}">立即登录</button>
    </view>
  </view>

  <!-- 主内容 -->
  <view class="main-content">
    <!-- 筛选栏 -->
    <filter-bar filter="{{filter}}" membershipType="{{membershipType}}" bind:change="onFilterChange" />

    <!-- Tab 切换 -->
    <view class="tab-bar">
      <view class="tab-item {{activeTab === 'assigned' ? 'active' : ''}}" bindtap="onTabSwitch" data-tab="assigned">为你推荐</view>
      <view class="tab-item {{activeTab === 'mine' ? 'active' : ''}}" bindtap="onTabSwitch" data-tab="mine">我的启事</view>
      <view class="tab-item {{activeTab === 'history' ? 'active' : ''}}" bindtap="onTabSwitch" data-tab="history">历史查看</view>
    </view>

    <!-- 随机分配的启事 / 公开推荐启事 -->
    <block wx:if="{{activeTab === 'assigned'}}">
      <view wx:if="{{assignedNotices.length === 0 && !loading}}" class="empty-state">
        <text class="icon">💝</text>
        <text>暂无可推荐的启事</text>
        <text class="sub-tip">请调整筛选条件或稍后再试</text>
      </view>
      <view class="waterfall" wx:else>
        <view class="waterfall-col">
          <notice-card
            wx:for="{{assignedLeft}}"
            wx:key="_id"
            notice="{{item}}"
            isLoggedIn="{{isLoggedIn}}"
            showPhone="{{false}}"
            bind:requirelogin="onRequireLogin"
            bind:viewdetail="onViewDetail"
          />
        </view>
        <view class="waterfall-col">
          <notice-card
            wx:for="{{assignedRight}}"
            wx:key="_id"
            notice="{{item}}"
            isLoggedIn="{{isLoggedIn}}"
            showPhone="{{false}}"
            bind:requirelogin="onRequireLogin"
            bind:viewdetail="onViewDetail"
          />
        </view>
      </view>
    </block>

    <!-- 我的启事 -->
    <block wx:if="{{activeTab === 'mine'}}">
      <view wx:if="{{!isLoggedIn}}" class="empty-state">
        <text class="icon">🔒</text>
        <text>请先登录查看您的启事</text>
        <button class="btn-primary" style="margin-top:20rpx;padding:12rpx 36rpx;font-size:26rpx;width:auto;" bindtap="onOpenLoginModal">立即登录</button>
      </view>
      <view wx:elif="{{myNotices.length === 0 && !loadingMy}}" class="empty-state">
        <text class="icon">📝</text>
        <text>暂无发布启事</text>
        <button class="btn-outline" style="margin-top:20rpx;" bindtap="onGoPublish">去发布</button>
      </view>
      <view class="waterfall" wx:else>
        <view class="waterfall-col">
          <notice-card
            wx:for="{{myLeft}}"
            wx:key="_id"
            notice="{{item}}"
            isLoggedIn="{{isLoggedIn}}"
            showPhone="{{true}}"
            hidePhoneAction="{{true}}"
            bind:viewdetail="onViewDetail"
          />
        </view>
        <view class="waterfall-col">
          <notice-card
            wx:for="{{myRight}}"
            wx:key="_id"
            notice="{{item}}"
            isLoggedIn="{{isLoggedIn}}"
            showPhone="{{true}}"
            hidePhoneAction="{{true}}"
            bind:viewdetail="onViewDetail"
          />
        </view>
      </view>
    </block>

    <!-- 历史查看 -->
    <block wx:if="{{activeTab === 'history'}}">
      <view wx:if="{{!isLoggedIn}}" class="empty-state">
        <text class="icon">🔒</text>
        <text>请先登录查看历史记录</text>
        <button class="btn-primary" style="margin-top:20rpx;padding:12rpx 36rpx;font-size:26rpx;width:auto;" bindtap="onOpenLoginModal">立即登录</button>
      </view>
      <view wx:elif="{{historyNotices.length === 0 && !loadingHistory}}" class="empty-state">
        <text class="icon">🕐</text>
        <text>暂无历史查看记录</text>
        <text class="sub-tip">系统每月或每天分配给你的启事会保存在这里</text>
      </view>
      <view class="waterfall" wx:else>
        <view class="waterfall-col">
          <notice-card
            wx:for="{{historyLeft}}"
            wx:key="_id"
            notice="{{item}}"
            isLoggedIn="{{isLoggedIn}}"
            showPhone="{{false}}"
            bind:requirelogin="onRequireLogin"
            bind:viewdetail="onViewDetail"
          />
        </view>
        <view class="waterfall-col">
          <notice-card
            wx:for="{{historyRight}}"
            wx:key="_id"
            notice="{{item}}"
            isLoggedIn="{{isLoggedIn}}"
            showPhone="{{false}}"
            bind:requirelogin="onRequireLogin"
            bind:viewdetail="onViewDetail"
          />
        </view>
      </view>
    </block>
  </view>

  <!-- 全量启事详情弹窗（包含全部资料、照片画廊与联系方式） -->
  <view class="detail-modal" wx:if="{{showDetailModal && detailNotice}}" bindtap="onCloseDetailModal">
    <view class="detail-card" catchtap="stopBubble">
      <view class="detail-header">
        <view class="detail-title-row">
          <text class="detail-name">{{detailNotice.name}}</text>
          <view class="detail-gender-tag {{detailNotice.gender === '男' ? 'male' : 'female'}}">
            <text>{{detailNotice.gender === '男' ? '♂' : '♀'}} {{detailNotice.gender}}</text>
          </view>
          <text class="detail-role" wx:if="{{detailNotice.publisherRole && detailNotice.publisherRole !== '本人'}}">{{detailNotice.publisherRole}}发布</text>
        </view>
        <text class="detail-close" bindtap="onCloseDetailModal">✕</text>
      </view>

      <scroll-view scroll-y="true" class="detail-scroll">
        <!-- 照片相册 -->
        <view class="detail-section" wx:if="{{detailNotice.images && detailNotice.images.length > 0}}">
          <text class="section-sub-title">个人照片 ({{detailNotice.images.length}}张)</text>
          <scroll-view scroll-x="true" class="photos-scroll">
            <image
              wx:for="{{detailNotice.images}}"
              wx:key="*this"
              class="photo-thumb-lg"
              src="{{item}}"
              mode="aspectFill"
              catchtap="onPreviewPhoto"
              data-src="{{item}}"
            />
          </scroll-view>
        </view>

        <!-- 详细信息网格 -->
        <view class="detail-section">
          <text class="section-sub-title">基本信息</text>
          <view class="detail-grid">
            <view class="detail-field" wx:if="{{detailNotice.age}}">
              <text class="field-label">年龄</text>
              <text class="field-value">{{detailNotice.age}}岁</text>
            </view>
            <view class="detail-field" wx:if="{{detailNotice.housingLocation}}">
              <text class="field-label">住房</text>
              <text class="field-value">{{detailNotice.housingLocation}}房</text>
            </view>
            <view class="detail-field" wx:if="{{detailNotice.height}}">
              <text class="field-label">身高</text>
              <text class="field-value">{{detailNotice.height}}cm</text>
            </view>
            <view class="detail-field" wx:if="{{detailNotice.weight}}">
              <text class="field-label">体重</text>
              <text class="field-value">{{detailNotice.weight}}kg</text>
            </view>
            <view class="detail-field" wx:if="{{detailNotice.occupation}}">
              <text class="field-label">职业</text>
              <text class="field-value">{{detailNotice.occupation}}</text>
            </view>
            <view class="detail-field" wx:if="{{detailNotice.income}}">
              <text class="field-label">收入</text>
              <text class="field-value font-highlight">{{detailNotice.income}}</text>
            </view>
            <view class="detail-field" wx:if="{{detailNotice.isPublicSector}}">
              <text class="field-label">体制内单位</text>
              <text class="field-value text-red">是</text>
            </view>
          </view>
        </view>

        <!-- 个人备注 -->
        <view class="detail-section" wx:if="{{detailNotice.remark}}">
          <text class="section-sub-title">个人心语 · 择偶要求</text>
          <view class="detail-remark-box">
            <text class="remark-content">{{detailNotice.remark}}</text>
          </view>
        </view>

        <!-- 联系方式卡片区 -->
        <view class="detail-section">
          <text class="section-sub-title">联系途径</text>
          <view class="contact-info-card">
            <!-- 手机号 -->
            <view class="contact-line">
              <view class="line-left">
                <text class="line-label">手机号码</text>
                <text class="line-val phone-highlight">{{detailNotice.fullPhone || detailNotice.phone}}</text>
              </view>
              <view class="line-actions" wx:if="{{detailNotice.fullPhone}}">
                <text class="mini-btn" bindtap="onCopyDetailPhone">复制</text>
                <text class="mini-btn btn-call" bindtap="onCallDetailPhone">拨打</text>
              </view>
            </view>

            <!-- 社交账号 -->
            <view class="contact-line" wx:if="{{detailNotice.socialAccount}}">
              <view class="line-left">
                <text class="line-label">社交账号</text>
                <text class="line-val social-highlight">{{detailNotice.socialAccount}}</text>
              </view>
              <view class="line-actions">
                <text class="mini-btn" bindtap="onCopyDetailSocial">复制</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
