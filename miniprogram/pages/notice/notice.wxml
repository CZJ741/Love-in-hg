<!-- pages/notice/notice.wxml -->
<view class="container">
  <!-- 登录弹窗 -->
  <view class="login-modal" wx:if="{{!isLoggedIn}}">
    <view class="login-card">
      <view class="login-title">登录相亲角</view>
      <view class="login-desc">请输入手机号码登录</view>
      <input class="login-input" type="number" maxlength="11" placeholder="请输入手机号码" value="{{loginPhone}}" bindinput="onPhoneInput" />
      <button class="btn-primary login-btn" bindtap="onLogin" loading="{{loggingIn}}">登录</button>
    </view>
  </view>

  <!-- 主内容 -->
  <block wx:if="{{isLoggedIn}}">
    <!-- 配额提示 -->
    <view class="quota-bar">
      <text class="quota-text">{{quotaLabel}} | 额度 <text class="quota-num">{{remaining}}</text> 条</text>
      <text class="quota-upgrade" bindtap="onGoMy">升级会员</text>
    </view>

    <!-- 筛选栏 -->
    <filter-bar filter="{{filter}}" bind:change="onFilterChange" />

    <!-- Tab 切换 -->
    <view class="tab-bar">
      <view class="tab-item {{activeTab === 'assigned' ? 'active' : ''}}" bindtap="onTabSwitch" data-tab="assigned">为你推荐</view>
      <view class="tab-item {{activeTab === 'mine' ? 'active' : ''}}" bindtap="onTabSwitch" data-tab="mine">我的启事</view>
      <view class="tab-item {{activeTab === 'history' ? 'active' : ''}}" bindtap="onTabSwitch" data-tab="history">历史查看</view>
    </view>

    <!-- 随机分配的启事 -->
    <block wx:if="{{activeTab === 'assigned'}}">
      <view wx:if="{{assignedNotices.length === 0 && !loading}}" class="empty-state">
        <text class="icon">💝</text>
        <text>暂无可推荐的启事</text>
        <text class="sub-tip">请调整筛选条件或升级会员获取更多</text>
      </view>
      <view class="waterfall" wx:else>
        <view class="waterfall-col">
          <notice-card
            wx:for="{{assignedLeft}}"
            wx:key="_id"
            notice="{{item}}"
            showPhone="{{false}}"
            bind:showphone="onShowPhone"
          />
        </view>
        <view class="waterfall-col">
          <notice-card
            wx:for="{{assignedRight}}"
            wx:key="_id"
            notice="{{item}}"
            showPhone="{{false}}"
            bind:showphone="onShowPhone"
          />
        </view>
      </view>
    </block>

    <!-- 我的启事 -->
    <block wx:if="{{activeTab === 'mine'}}">
      <view wx:if="{{myNotices.length === 0 && !loadingMy}}" class="empty-state">
        <text class="icon">📝</text>
        <text>暂无发布启事</text>
        <button class="btn-outline" style="margin-top:20rpx;" bindtap="onGoPublish">去发布</button>
      </view>
      <view class="waterfall" wx:else>
        <view class="waterfall-col">
          <notice-card
            wx:for="{{myLeft}}"
            wx:key="_id"
            notice="{{item}}"
            showPhone="{{true}}"
            hidePhoneAction="{{true}}"
          />
        </view>
        <view class="waterfall-col">
          <notice-card
            wx:for="{{myRight}}"
            wx:key="_id"
            notice="{{item}}"
            showPhone="{{true}}"
            hidePhoneAction="{{true}}"
          />
        </view>
      </view>
    </block>

    <!-- 历史查看 -->
    <block wx:if="{{activeTab === 'history'}}">
      <view wx:if="{{historyNotices.length === 0 && !loadingHistory}}" class="empty-state">
        <text class="icon">🕐</text>
        <text>暂无历史查看记录</text>
        <text class="sub-tip">系统每月或每天分配给你的启事会保存在这里</text>
      </view>
      <view class="waterfall" wx:else>
        <view class="waterfall-col">
          <notice-card
            wx:for="{{historyLeft}}"
            wx:key="_id"
            notice="{{item}}"
            showPhone="{{false}}"
            bind:showphone="onShowPhone"
          />
        </view>
        <view class="waterfall-col">
          <notice-card
            wx:for="{{historyRight}}"
            wx:key="_id"
            notice="{{item}}"
            showPhone="{{false}}"
            bind:showphone="onShowPhone"
          />
        </view>
      </view>
    </block>
  </block>
</view>
