/* pages/notice/notice.wxss */

/* 登录/注册弹窗 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.login-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 44rpx 40rpx;
  width: 580rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
}

.login-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

/* 顶部简洁 Tab */
.auth-tabs {
  display: flex;
  gap: 32rpx;
}

.auth-tab {
  font-size: 32rpx;
  font-weight: 500;
  color: #999;
  position: relative;
  padding-bottom: 8rpx;
}

.auth-tab.active {
  color: #333;
  font-weight: bold;
}

.auth-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 4rpx;
  background: #e74c3c;
  border-radius: 2rpx;
}

.login-close {
  font-size: 36rpx;
  color: #bbb;
  padding: 0 8rpx;
  line-height: 1;
}

.login-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.login-input {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  min-height: 84rpx;
  line-height: normal;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 28rpx;
  background: #fafafa;
}

.login-input:focus {
  border-color: #e74c3c;
  background: #fff;
}

.login-btn {
  width: 100% !important;
  border-radius: 12rpx;
}

/* 验证码输入行 */
.verify-code-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 28rpx;
}

.code-input {
  flex: 1;
  margin-bottom: 0 !important;
}

.btn-send-code {
  width: 200rpx !important;
  height: 84rpx;
  line-height: 84rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #e74c3c;
  padding: 0;
  text-align: center;
  margin: 0 !important;
  box-sizing: border-box;
}

.btn-send-code.disabled {
  background: #f1f5f9;
  color: #94a3b8;
  border-color: #e2e8f0;
}

/* 访客提示条 */
.unlogin-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff8e6;
  border: 1rpx solid #ffe58f;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.banner-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}

.banner-icon {
  font-size: 28rpx;
}

.banner-text {
  font-size: 24rpx;
  color: #d46b08;
  line-height: 1.4;
}

.banner-btn {
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff9966, #ff5e62);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 登录弹窗头部 */
.login-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.login-close {
  font-size: 36rpx;
  color: #999;
  padding: 4rpx 12rpx;
  line-height: 1;
}

/* Tab 切换 */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #888;
  position: relative;
  transition: all 0.2s;
}

.tab-item.active {
  color: #e74c3c;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #e74c3c;
  border-radius: 3rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0 40rpx;
  font-size: 26rpx;
  color: #999;
}

/* 列表底部开通VIP获取更多启事上拉提示 */
.vip-footer-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0 50rpx;
  gap: 8rpx;
  animation: fadeInTip 0.3s ease-in-out;
}

@keyframes fadeInTip {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.vip-footer-tip .vip-icon {
  font-size: 26rpx;
}

.vip-footer-tip .vip-text {
  font-size: 24rpx;
  color: #94a3b8;
  letter-spacing: 0.5rpx;
}

.no-more {
  color: #ccc;
}

.sub-tip {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* 两列瀑布流 */
.waterfall {
  display: flex;
  align-items: flex-start;
}

.waterfall-col {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
}

.waterfall-col:first-child {
  padding-right: 10rpx;
}

.waterfall-col:last-child {
  padding-left: 10rpx;
}

/* 全量启事详情弹窗 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 30rpx;
  backdrop-filter: blur(6px);
}

.detail-card {
  background: #ffffff;
  border-radius: 28rpx;
  width: 100%;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  animation: modalFadeIn 0.2s ease-out;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.detail-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.detail-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #1e293b;
}

.detail-gender-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.detail-gender-tag.male {
  background: #ebf5fb;
  color: #2980b9;
}

.detail-gender-tag.female {
  background: #fdf2e9;
  color: #d35400;
}

.detail-role {
  font-size: 20rpx;
  color: #8c9ba5;
  background: #f4f6f8;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.detail-close {
  font-size: 38rpx;
  color: #94a3b8;
  padding: 6rpx 12rpx;
  line-height: 1;
}

.detail-scroll {
  flex: 1;
  max-height: 70vh;
  padding: 24rpx 36rpx 40rpx;
  box-sizing: border-box;
}

.detail-section {
  margin-bottom: 28rpx;
}

.detail-section:last-child {
  margin-bottom: 0;
}

.section-sub-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #64748b;
  margin-bottom: 14rpx;
  display: block;
}

/* 照片横向相册 */
.photos-scroll {
  white-space: nowrap;
  width: 100%;
}

.photo-thumb-lg {
  display: inline-block;
  width: 180rpx;
  height: 180rpx;
  border-radius: 14rpx;
  margin-right: 16rpx;
  background: #f1f5f9;
}

/* 详情网格 */
.detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-field {
  width: calc(50% - 6rpx);
  background: #f8fafc;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.field-label {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 4rpx;
}

.field-value {
  font-size: 27rpx;
  color: #1e293b;
  font-weight: 600;
}

.font-highlight {
  color: #e67e22;
}

.text-red {
  color: #e11d48;
}

/* 备注盒子 */
.detail-remark-box {
  background: #fdf6f4;
  border-left: 6rpx solid #f2b8b8;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
}

.remark-content {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.6;
  word-break: break-all;
}

/* 联系方式卡片 */
.contact-info-card {
  background: #fafafa;
  border: 1rpx solid #f1f5f9;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}

.contact-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed #e2e8f0;
}

.contact-line:last-child {
  border-bottom: none;
}

.line-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.line-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.line-val {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.phone-highlight {
  color: #e11d48;
}

.social-highlight {
  color: #2563eb;
}

.line-actions {
  display: flex;
  gap: 12rpx;
}

.mini-btn {
  font-size: 23rpx;
  color: #475569;
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  padding: 8rpx 22rpx;
  border-radius: 30rpx;
  font-weight: 500;
}

.mini-btn:active {
  background: #f1f5f9;
}

.mini-btn.btn-call {
  background: linear-gradient(135deg, #ff5e62, #ff9966);
  color: #ffffff;
  border: none;
  box-shadow: 0 4rpx 10rpx rgba(255, 94, 98, 0.3);
}

.mini-btn.btn-call:active {
  opacity: 0.9;
}

/* UGC 维权操作区：举报与屏蔽拉黑 */
.detail-ugc-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 30rpx 0 10rpx;
}

.ugc-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #888;
  padding: 8rpx 16rpx;
}

.ugc-text {
  font-size: 24rpx;
}

.ugc-split {
  color: #ddd;
  font-size: 24rpx;
}

/* 举报弹窗 */
.report-card {
  box-sizing: border-box;
}

.report-tip {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.report-picker-trigger {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.picker-label {
  color: #94a3b8;
}

.picker-val {
  flex: 1;
  color: #1e293b;
  font-weight: 500;
}

.picker-arrow {
  font-size: 22rpx;
  color: #94a3b8;
}

.report-textarea {
  width: 100%;
  box-sizing: border-box;
  height: 180rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 30rpx;
}

.report-submit-btn {
  width: 100% !important;
  margin-top: 10rpx;
}
