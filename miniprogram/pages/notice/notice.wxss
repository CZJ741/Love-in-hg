/* pages/notice/notice.wxss */

/* 登录弹窗 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.login-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 44rpx;
  width: 600rpx;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.12);
}

.login-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.login-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 44rpx;
}

.login-input {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 34rpx;
  text-align: center;
  margin-bottom: 32rpx;
  letter-spacing: 4rpx;
  background: #fafafa;
}

.login-input:focus {
  border-color: #e74c3c;
  background: #fff;
}

.login-btn {
  width: 100%;
  border-radius: 12rpx;
}

/* 配额栏 */
.quota-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #fff5f5 0%, #fff 100%);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #fde8e8;
}

.quota-text {
  font-size: 26rpx;
  color: #666;
}

.quota-num {
  color: #e74c3c;
  font-weight: bold;
  font-size: 34rpx;
}

.quota-upgrade {
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #e74c3c, #f37055);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* Tab 切换 */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #888;
  position: relative;
  transition: all 0.2s;
}

.tab-item.active {
  color: #e74c3c;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #e74c3c;
  border-radius: 3rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0 40rpx;
  font-size: 26rpx;
  color: #999;
}

.no-more {
  color: #ccc;
}

.sub-tip {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* 两列瀑布流 */
.waterfall {
  display: flex;
  align-items: flex-start;
}

.waterfall-col {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
}

.waterfall-col:first-child {
  padding-right: 10rpx;
}

.waterfall-col:last-child {
  padding-left: 10rpx;
}
