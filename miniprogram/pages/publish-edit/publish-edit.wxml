<!-- pages/publish-edit/publish-edit.wxml -->
<view class="container">
  <view class="publish-header card">
    <text class="publish-title">{{isEdit ? '修改启事' : '发布启事'}}</text>
    <text class="publish-desc">填写您的个人信息，让更多人发现你</text>
  </view>

  <view class="form-section card">
    <view class="section-title">必填信息</view>

    <view class="form-item">
      <text class="form-label">手机号码 <text class="required">*</text></text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号码" value="{{form.phone}}" bindinput="onFieldChange" data-field="phone" disabled="{{isEdit}}" />
    </view>

    <view class="form-item">
      <text class="form-label">姓名 <text class="required">*</text></text>
      <input class="form-input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onFieldChange" data-field="name" />
    </view>

    <view class="form-item">
      <text class="form-label">性别 <text class="required">*</text></text>
      <view class="radio-group">
        <view class="radio-item {{form.gender === '男' ? 'checked' : ''}}" bindtap="onSelectGender" data-value="男">
          <text>男</text>
        </view>
        <view class="radio-item {{form.gender === '女' ? 'checked' : ''}}" bindtap="onSelectGender" data-value="女">
          <text>女</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">生日 <text class="required">*</text></text>
      <picker mode="date" value="{{form.birthday}}" start="1950-01-01" end="{{maxBirthday}}" bindchange="onBirthdayChange">
        <view class="picker-value {{form.birthday ? '' : 'placeholder'}}">
          {{form.birthday || '请选择生日'}}
        </view>
      </picker>
      <text class="form-tip">本平台仅面向年满18周岁的用户</text>
    </view>
  </view>

  <view class="form-section card">
    <view class="section-title">选填信息（建议完善，更容易获得匹配）</view>

    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" placeholder="请输入昵称" value="{{form.nickname}}" bindinput="onFieldChange" data-field="nickname" />
    </view>

    <view class="form-item">
      <text class="form-label">职业</text>
      <input class="form-input" placeholder="请输入职业" value="{{form.occupation}}" bindinput="onFieldChange" data-field="occupation" />
    </view>

    <view class="form-item">
      <text class="form-label">收入</text>
      <picker mode="selector" range="{{incomeOptions}}" bindchange="onIncomeChange">
        <view class="picker-value {{form.income ? '' : 'placeholder'}}">
          {{form.income || '请选择收入范围'}}
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">是否体制内</text>
      <view class="radio-group">
        <view class="radio-item {{form.isPublicSector === true ? 'checked' : ''}}" bindtap="onSelectSector" data-value="{{true}}">
          <text>是</text>
        </view>
        <view class="radio-item {{form.isPublicSector === false ? 'checked' : ''}}" bindtap="onSelectSector" data-value="{{false}}">
          <text>否</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">身高 (cm)</text>
      <input class="form-input" type="number" placeholder="请输入身高" value="{{form.height}}" bindinput="onFieldChange" data-field="height" />
    </view>

    <view class="form-item">
      <text class="form-label">体重 (kg)</text>
      <input class="form-input" type="number" placeholder="请输入体重" value="{{form.weight}}" bindinput="onFieldChange" data-field="weight" />
    </view>

    <view class="form-item">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" placeholder="请输入备注信息，如个人简介、择偶要求等" value="{{form.remark}}" bindinput="onFieldChange" data-field="remark" maxlength="500" auto-height />
      <text class="char-count">{{form.remark.length || 0}}/500</text>
    </view>
  </view>

  <button class="btn-primary submit-btn" bindtap="onSubmit" loading="{{submitting}}">{{isEdit ? '保存修改' : '发布启事'}}</button>
</view>
