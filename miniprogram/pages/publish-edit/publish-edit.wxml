<!-- pages/publish-edit/publish-edit.wxml -->
<view class="container">
  <view class="publish-header card">
    <view class="header-left">
      <text class="publish-title">{{isEdit ? '修改启事' : '发布启事'}}</text>
    </view>
    <view class="draft-action" wx:if="{{!isEdit}}">
      <view class="btn-draft-save" bindtap="onSaveDraft">暂存草稿</view>
      <view class="btn-draft-clear" wx:if="{{hasDraft}}" bindtap="onClearDraft">清除暂存</view>
    </view>
  </view>


  <!-- 发布人模块（置于必填信息之上） -->
  <view class="form-section card">
    <view class="section-title">发布人信息</view>

    <view class="form-item">
      <text class="form-label">发布人身份 <text class="required">*</text></text>
      <view class="choice-pills">
        <view
          wx:for="{{publisherRoles}}"
          wx:key="*this"
          class="pill-item {{form.publisherRole === item ? 'pill-active' : ''}}"
          bindtap="onSelectPublisherRole"
          data-role="{{item}}"
        >
          <text class="pill-check" wx:if="{{form.publisherRole === item}}">✓</text>
          <text class="pill-text">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">联系方式 <text class="required">*</text></text>
      <input
        class="form-input disabled-input"
        type="number"
        maxlength="11"
        placeholder="登录手机号自动关联"
        value="{{form.phone}}"
        disabled="true"
      />
    </view>
  </view>

  <!-- 必填信息 -->
  <view class="form-section card section-required">
    <view class="section-title">必填基本信息</view>

    <view class="form-item">
      <text class="form-label">姓名 <text class="required">*</text></text>
      <input class="form-input input-required" placeholder="请输入姓名" value="{{form.name}}" bindinput="onFieldChange" data-field="name" />
    </view>

    <view class="form-item">
      <text class="form-label">性别 <text class="required">*</text></text>
      <view class="choice-pills">
        <view
          class="pill-item {{form.gender === '男' ? 'pill-active gender-male' : ''}}"
          bindtap="onSelectGender"
          data-value="男"
        >
          <text class="pill-check" wx:if="{{form.gender === '男'}}">✓</text>
          <text class="pill-text">男</text>
        </view>
        <view
          class="pill-item {{form.gender === '女' ? 'pill-active gender-female' : ''}}"
          bindtap="onSelectGender"
          data-value="女"
        >
          <text class="pill-check" wx:if="{{form.gender === '女'}}">✓</text>
          <text class="pill-text">女</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">年龄 <text class="required">*</text></text>
      <input
        class="form-input input-required"
        type="number"
        placeholder="请输入年龄，如 25"
        value="{{form.age}}"
        bindinput="onFieldChange"
        data-field="age"
      />
    </view>

    <view class="form-item">
      <text class="form-label">住房位置 <text class="required">*</text></text>
      <view class="choice-pills">
        <view
          class="pill-item {{form.housingLocation === '本地' ? 'pill-active' : ''}}"
          bindtap="onSelectHousingLocation"
          data-value="本地"
        >
          <text class="pill-check" wx:if="{{form.housingLocation === '本地'}}">✓</text>
          <text class="pill-text">本地</text>
        </view>
        <view
          class="pill-item {{form.housingLocation === '外地' ? 'pill-active' : ''}}"
          bindtap="onSelectHousingLocation"
          data-value="外地"
        >
          <text class="pill-check" wx:if="{{form.housingLocation === '外地'}}">✓</text>
          <text class="pill-text">外地</text>
        </view>
      </view>
    </view>
  </view>



  <!-- 图片上传板块（位于必填与选填中间，支持最多9张） -->
  <view class="form-section card">
    <view class="section-header-row">
      <text class="section-title mb-0">上传照片</text>
      <text class="section-subtitle">展示真实风采（{{images.length}}/9）</text>
    </view>
    <view class="uploader-grid">
      <view class="uploader-item" wx:for="{{images}}" wx:key="index">
        <image class="uploader-img" src="{{item}}" mode="aspectFill" bindtap="onPreviewImage" data-current="{{item}}" />
        <view class="uploader-delete" catchtap="onDeleteImage" data-index="{{index}}">
          <text class="uploader-delete-icon">×</text>
        </view>
      </view>
      <view class="uploader-add" bindtap="onChooseImages" wx:if="{{images.length < 9}}">
        <text class="uploader-add-icon">+</text>
        <text class="uploader-add-text">上传照片</text>
      </view>
    </view>
  </view>

  <!-- 选填信息 -->
  <view class="form-section card">
    <view class="section-title">选填信息（建议完善，更容易获得匹配）</view>

    <!-- 第一行：身高与体重并排显示 -->
    <view class="form-row">
      <view class="form-col">
        <text class="form-label">身高 (cm)</text>
        <input class="form-input" type="number" placeholder="如 175" value="{{form.height}}" bindinput="onFieldChange" data-field="height" />
      </view>
      <view class="form-col">
        <text class="form-label">体重 (kg)</text>
        <input class="form-input" type="number" placeholder="如 65" value="{{form.weight}}" bindinput="onFieldChange" data-field="weight" />
      </view>
    </view>

    <!-- 第二行：职业与收入并排显示 -->
    <view class="form-row">
      <view class="form-col">
        <text class="form-label">职业</text>
        <input class="form-input" placeholder="请输入职业" value="{{form.occupation}}" bindinput="onFieldChange" data-field="occupation" />
      </view>
      <view class="form-col">
        <text class="form-label">收入</text>
        <picker mode="selector" range="{{incomeOptions}}" bindchange="onIncomeChange">
          <view class="picker-value {{form.income ? '' : 'placeholder'}}">
            {{form.income || '选择收入'}}
          </view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">是否体制内</text>
      <view class="choice-pills">
        <view
          class="pill-item {{form.isPublicSector === true ? 'pill-active' : ''}}"
          bindtap="onSelectSector"
          data-value="{{true}}"
        >
          <text class="pill-check" wx:if="{{form.isPublicSector === true}}">✓</text>
          <text class="pill-text">是（体制内）</text>
        </view>
        <view
          class="pill-item {{form.isPublicSector === false ? 'pill-active' : ''}}"
          bindtap="onSelectSector"
          data-value="{{false}}"
        >
          <text class="pill-check" wx:if="{{form.isPublicSector === false}}">✓</text>
          <text class="pill-text">否</text>
        </view>
      </view>
    </view>


    <view class="form-item">
      <text class="form-label">社交账号</text>
      <input class="form-input" placeholder="请输入微信号/QQ等社交账号" value="{{form.socialAccount}}" bindinput="onFieldChange" data-field="socialAccount" />
    </view>

    <view class="form-item">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" placeholder="请输入备注信息，如个人简介、择偶要求等" value="{{form.remark}}" bindinput="onFieldChange" data-field="remark" maxlength="500" auto-height />
      <text class="char-count">{{form.remark.length || 0}}/500</text>
    </view>
  </view>


  <button class="btn-primary submit-btn" bindtap="onSubmit" loading="{{submitting}}">{{isEdit ? '保存修改' : '发布'}}</button>

  <!-- 隐私授权合规弹窗 -->
  <privacy-popup></privacy-popup>
</view>
