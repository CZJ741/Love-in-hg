/* pages/publish-edit/publish-edit.wxss */
.publish-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #fffbf9 100%);
  border-radius: 18rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(231, 76, 60, 0.05);
}

.publish-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  letter-spacing: 2rpx;
}

.draft-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.btn-draft-save {
  font-size: 24rpx;
  color: #e74c3c;
  background: #fdf2f2;
  border: 1rpx solid #fecaca;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 500;
}

.btn-draft-save:active {
  background: #fee2e2;
}

.btn-draft-clear {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 8rpx 12rpx;
}


/* 表单卡片模块 */
.form-section {
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.03);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #f2f2f2;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 26rpx;
  background: #e74c3c;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.form-item {
  margin-bottom: 22rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.required {
  color: #e74c3c;
  margin-left: 4rpx;
}

.form-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

/* 输入框与选择器统一规范（尺寸适当缩小，避免挤压） */
.form-input {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  border: 1.5rpx solid #e2e4e8;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #222;
  background: #fafafa;
  transition: border-color 0.2s, background-color 0.2s;
}

.form-input:focus {
  border-color: #ff9b7e;
  background: #fff;
}

.form-input[disabled] {
  background: #f4f4f5;
  color: #909399;
  border-color: #e4e7ed;
}

.form-input[disabled].input-required {
  background-color: #fff2ed !important;
  color: #777;
  border-color: #ffd8cc !important;
}

.picker-value {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  line-height: 74rpx;
  padding: 0 20rpx;
  border: 1.5rpx solid #e2e4e8;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #222;
  background: #fafafa;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-value.placeholder {
  color: #a8abb2;
}

/* 必填项专属浅橘红色背景 */
.input-required {
  background-color: #fff7f4 !important;
  border-color: #ffded4 !important;
}

.input-required:focus {
  border-color: #ff7854 !important;
  background-color: #fffbf9 !important;
}

/* 药丸/勾选式单选选项 (Choice Pills - 适当微缩尺寸) */
.choice-pills {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.pill-item {
  flex: 1;
  min-width: 110rpx;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f8fa;
  border: 1.5rpx solid #e5e7eb;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #4b5563;
  transition: all 0.2s ease;
  box-sizing: border-box;
  padding: 0 12rpx;
}

.pill-check {
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 6rpx;
  color: #e74c3c;
}

.pill-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* 激活状态 */
.pill-item.pill-active {
  background: #fdf0ed;
  border-color: #e74c3c;
  color: #e74c3c;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(231, 76, 60, 0.1);
}

/* 性别定制微调高亮 */
.pill-item.gender-male.pill-active {
  background: #eff6ff;
  border-color: #3b82f6;
  color: #2563eb;
  box-shadow: 0 2rpx 6rpx rgba(37, 99, 235, 0.1);
}
.pill-item.gender-male.pill-active .pill-check {
  color: #2563eb;
}

.pill-item.gender-female.pill-active {
  background: #fdf2f8;
  border-color: #ec4899;
  color: #db2777;
  box-shadow: 0 2rpx 6rpx rgba(219, 39, 119, 0.1);
}
.pill-item.gender-female.pill-active .pill-check {
  color: #db2777;
}

/* 选填并排两列布局 */
.form-row {
  display: flex;
  margin-bottom: 22rpx;
  gap: 16rpx;
}

.form-col {
  flex: 1;
  min-width: 0;
}

.form-col .form-input,
.form-col .picker-value {
  width: 100%;
  box-sizing: border-box;
}

/* 多行文本域 */
.form-textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1.5rpx solid #e2e4e8;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #222;
  background: #fafafa;
  min-height: 150rpx;
  line-height: 1.5;
}

.form-textarea:focus {
  border-color: #ff9b7e;
  background: #fff;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}

/* 图片上传组件样式 (适当微调尺寸) */
.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.section-header-row .section-title {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.section-subtitle {
  font-size: 22rpx;
  color: #999;
}

.uploader-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.uploader-item,
.uploader-add {
  position: relative;
  width: calc((100% - 28rpx) / 3);
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.uploader-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.uploader-delete {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.uploader-delete-icon {
  color: #fff;
  font-size: 30rpx;
  line-height: 1;
  font-weight: bold;
}

.uploader-add {
  border: 2rpx dashed #d1d5db;
  background: #f9fafb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.uploader-add:active {
  background: #f3f4f6;
  border-color: #ff9b7e;
}

.uploader-add-icon {
  font-size: 46rpx;
  color: #9ca3af;
  line-height: 1;
  margin-bottom: 6rpx;
}

.uploader-add-text {
  font-size: 22rpx;
  color: #6b7280;
}

/* 提交按钮（适当缩小高度与字号，更显精致） */
.submit-btn {
  margin: 30rpx 0 40rpx;
  width: 100%;
  height: 82rpx;
  line-height: 82rpx;
  padding: 0;
  border-radius: 41rpx;
  background: linear-gradient(135deg, #ff6b52 0%, #e74c3c 100%);
  box-shadow: 0 6rpx 16rpx rgba(231, 76, 60, 0.25);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}



