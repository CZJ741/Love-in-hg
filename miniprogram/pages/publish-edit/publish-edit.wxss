/* pages/publish-edit/publish-edit.wxss */
.publish-header {
  text-align: center;
  padding: 40rpx;
}

.publish-title {
  font-size: 38rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.publish-desc {
  font-size: 26rpx;
  color: #999;
}

/* 表单 */
.form-section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.required {
  color: #e74c3c;
}

.form-tip {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
  display: block;
}

.form-input {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  background: #fff;
}

.form-input[disabled] {
  background: #f5f5f5;
  color: #999;
}

.picker-value {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  background: #fff;
}

.picker-value.placeholder {
  color: #999;
}

/* 单选 */
.radio-group {
  display: flex;
}

.radio-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border: 1rpx solid #ddd;
  font-size: 28rpx;
  color: #666;
  background: #fff;
}

.radio-item:first-child {
  border-radius: 8rpx 0 0 8rpx;
}

.radio-item:last-child {
  border-radius: 0 8rpx 8rpx 0;
}

.radio-item.checked {
  background: #e74c3c;
  color: #fff;
  border-color: #e74c3c;
}

.submit-btn {
  margin-top: 30rpx;
  width: 100%;
}

.form-textarea {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  background: #fff;
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}
