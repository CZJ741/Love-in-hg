/* pages/publish-edit/publish-edit.wxss */
.publish-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #fffbf9 100%);
  border-radius: 18rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(231, 76, 60, 0.05);
}

.publish-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  letter-spacing: 2rpx;
}

.draft-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.btn-draft-save {
  font-size: 24rpx;
  color: #e74c3c;
  background: #fdf2f2;
  border: 1rpx solid #fecaca;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 500;
}

.btn-draft-save:active {
  background: #fee2e2;
}

.btn-draft-clear {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 8rpx 12rpx;
}


/* 表单卡片模块 */
.form-section {
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.03);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #f2f2f2;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 26rpx;
  background: #e74c3c;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.form-item {
  margin-bottom: 22rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.required {
  color: #e74c3c;
  margin-left: 4rpx;
}

.form-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

/* 输入框与选择器统一规范（采用浅蓝色区分界面白底，提升层次感与精致度） */
.form-input {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  border: 1.5rpx solid #d5e5f5;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #222;
  background: #f2f7fd;
  transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
}

.form-input:focus {
  border-color: #3b82f6;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(59, 130, 246, 0.12);
}

.form-input[disabled] {
  background: #eef3f8;
  color: #94a3b8;
  border-color: #e2e8f0;
}

.form-input[disabled].input-required {
  background-color: #e9f2fb !important;
  color: #64748b;
  border-color: #cbdcf0 !important;
}

.picker-value {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  line-height: 74rpx;
  padding: 0 20rpx;
  border: 1.5rpx solid #d5e5f5;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #222;
  background: #f2f7fd;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: border-color 0.2s, background-color 0.2s;
}

.picker-value.placeholder {
  color: #94a3b8;
}

/* 必填项背景优化（保持浅蓝协调基调并略加强调） */
.input-required {
  background-color: #eef6fd !important;
  border-color: #c8def6 !important;
}

.input-required:focus {
  border-color: #3b82f6 !important;
  background-color: #ffffff !important;
  box-shadow: 0 0 0 4rpx rgba(59, 130, 246, 0.12) !important;
}

/* 单选勾选组 (Radio Choice Group) */
.radio-group-wrap {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 6rpx 0;
}

.radio-option {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: #f2f7fd;
  border: 1.5rpx solid #d5e5f5;
  border-radius: 36rpx;
  transition: all 0.2s ease;
}

.radio-circle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #94a3b8;
  background: #ffffff;
  box-sizing: border-box;
  margin-right: 14rpx;
  position: relative;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.radio-circle.checked {
  border-color: #3b82f6;
  background: #3b82f6;
}

.radio-circle.checked::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffffff;
}

.radio-label {
  font-size: 26rpx;
  color: #334155;
  font-weight: 500;
  line-height: 1;
}

.radio-option.active {
  background: #e8f2fe;
  border-color: #93c5fd;
}

.radio-option.active .radio-label {
  color: #1d4ed8;
  font-weight: 600;
}

/* 性别定制色系 */
.radio-option.active-male {
  background: #eff6ff;
  border-color: #93c5fd;
}
.radio-circle.checked-male {
  border-color: #3b82f6;
  background: #3b82f6;
}
.radio-option.active-male .radio-label {
  color: #1d4ed8;
}

.radio-option.active-female {
  background: #fdf2f8;
  border-color: #fbcfe8;
}
.radio-circle.checked-female {
  border-color: #ec4899;
  background: #ec4899;
}
.radio-option.active-female .radio-label {
  color: #be185d;
}

/* 药丸/勾选式单选选项 (Choice Pills - 适当微缩尺寸，用于其他可能选项) */
.choice-pills {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.pill-item {
  flex: 1;
  min-width: 110rpx;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f8fc;
  border: 1.5rpx solid #dbe7f3;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #4b5563;
  transition: all 0.2s ease;
  box-sizing: border-box;
  padding: 0 12rpx;
}

.pill-check {
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 6rpx;
  color: #e74c3c;
}

.pill-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* 激活状态 */
.pill-item.pill-active {
  background: #fdf0ed;
  border-color: #e74c3c;
  color: #e74c3c;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(231, 76, 60, 0.1);
}

/* 性别定制微调高亮 */
.pill-item.gender-male.pill-active {
  background: #eff6ff;
  border-color: #3b82f6;
  color: #2563eb;
  box-shadow: 0 2rpx 6rpx rgba(37, 99, 235, 0.1);
}
.pill-item.gender-male.pill-active .pill-check {
  color: #2563eb;
}

.pill-item.gender-female.pill-active {
  background: #fdf2f8;
  border-color: #ec4899;
  color: #db2777;
  box-shadow: 0 2rpx 6rpx rgba(219, 39, 119, 0.1);
}
.pill-item.gender-female.pill-active .pill-check {
  color: #db2777;
}

/* 选填并排两列布局 */
.form-row {
  display: flex;
  margin-bottom: 22rpx;
  gap: 16rpx;
}

.form-col {
  flex: 1;
  min-width: 0;
}

.form-col .form-input,
.form-col .picker-value {
  width: 100%;
  box-sizing: border-box;
}

/* 多行文本域 */
.form-textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1.5rpx solid #d5e5f5;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #222;
  background: #f2f7fd;
  min-height: 150rpx;
  line-height: 1.5;
  transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
}

.form-textarea:focus {
  border-color: #3b82f6;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(59, 130, 246, 0.12);
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}

/* 图片上传组件样式 (适当微调尺寸) */
.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.section-header-row .section-title {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.section-subtitle {
  font-size: 22rpx;
  color: #999;
}

.uploader-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.uploader-item,
.uploader-add {
  position: relative;
  width: calc((100% - 28rpx) / 3);
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.uploader-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.uploader-delete {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.uploader-delete-icon {
  color: #fff;
  font-size: 30rpx;
  line-height: 1;
  font-weight: bold;
}

.uploader-add {
  border: 2rpx dashed #d1d5db;
  background: #f9fafb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.uploader-add:active {
  background: #f3f4f6;
  border-color: #ff9b7e;
}

.uploader-add-icon {
  font-size: 46rpx;
  color: #9ca3af;
  line-height: 1;
  margin-bottom: 6rpx;
}

.uploader-add-text {
  font-size: 22rpx;
  color: #6b7280;
}

/* 提交按钮（适当缩小高度与字号，更显精致） */
.submit-btn {
  margin: 30rpx 0 40rpx;
  width: 100%;
  height: 82rpx;
  line-height: 82rpx;
  padding: 0;
  border-radius: 41rpx;
  background: linear-gradient(135deg, #ff6b52 0%, #e74c3c 100%);
  box-shadow: 0 6rpx 16rpx rgba(231, 76, 60, 0.25);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}



