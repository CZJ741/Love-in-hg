<!-- pages/publish/publish.wxml -->
<view class="publish-page">
  <!-- 顶栏：轻量化标题 + 悬浮胶囊按钮 -->
  <view class="page-header">
    <view class="header-content">
      <view class="title-wrap">
        <text class="page-title">我的启事</text>
        <text class="page-count" wx:if="{{myNotices.length > 0}}">共 {{myNotices.length}} 条</text>
      </view>
      <view class="btn-create" bindtap="onNewNotice">
        <text class="icon-plus">+</text>
        <text class="btn-create-text">新增启事</text>
      </view>
    </view>
  </view>

  <view class="page-body">
    <!-- 加载中 -->
    <view class="loading-state" wx:if="{{loading}}">
      <view class="loading-dots">
        <text class="dot"></text><text class="dot"></text><text class="dot"></text>
      </view>
      <text class="loading-text">正在加载启事...</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-card" wx:if="{{myNotices.length === 0 && !loading}}">
      <view class="empty-art">💌</view>
      <text class="empty-title">还没有发布相亲启事</text>
      <text class="empty-desc">发布启事，让对的人在这里与您相遇</text>
      <button class="btn-empty-action" bindtap="onNewNotice">立即发布第一条启事</button>
    </view>

    <!-- 完整启事卡片流 -->
    <view class="my-card {{item.gender === '男' ? 'gender-male' : 'gender-female'}}" wx:for="{{myNotices}}" wx:key="id">
      <!-- 顶部轻奢装饰边条 -->
      <view class="card-bar"></view>

      <!-- 卡片头部：姓名/性别 + 操作按钮 -->
      <view class="card-head">
        <view class="head-left">
          <text class="user-name">{{item.name}}</text>
          <view class="gender-pill {{item.gender === '男' ? 'pill-male' : 'pill-female'}}">
            <text class="gender-symbol">{{item.gender === '男' ? '♂' : '♀'}}</text>
            <text class="age-val" wx:if="{{item.age}}">{{item.age}}岁</text>
            <text class="age-val" wx:else>{{item.gender}}</text>
          </view>
          <text class="role-tag" wx:if="{{item.publisherRole && item.publisherRole !== '本人'}}">{{item.publisherRole}}发布</text>
        </view>

        <!-- 右上角精简操作按钮 -->
        <view class="head-actions">
          <view class="btn-pill btn-pill-edit" bindtap="onEditNotice" data-notice="{{item}}">
            <text class="btn-pill-text">编辑</text>
          </view>
          <view class="btn-pill btn-pill-del" bindtap="onDeleteNotice" data-id="{{item.id}}" data-name="{{item.name}}">
            <text class="btn-pill-text">删除</text>
          </view>
        </view>
      </view>

      <!-- 属性列表（单行列表排布） -->
      <view class="card-meta-list">
        <view class="meta-row">
          <text class="meta-name">性别</text>
          <text class="meta-val">{{item.gender}}</text>
        </view>

        <view class="meta-row" wx:if="{{item.age}}">
          <text class="meta-name">年龄</text>
          <text class="meta-val num">{{item.age}} 岁</text>
        </view>

        <view class="meta-row" wx:if="{{item.housingLocation}}">
          <text class="meta-name">住房</text>
          <view class="meta-val">
            <text class="status-tag tag-house">{{item.housingLocation}}房</text>
          </view>
        </view>

        <view class="meta-row" wx:if="{{item.height}}">
          <text class="meta-name">身高</text>
          <text class="meta-val num">{{item.height}} cm</text>
        </view>

        <view class="meta-row" wx:if="{{item.weight}}">
          <text class="meta-name">体重</text>
          <text class="meta-val num">{{item.weight}} kg</text>
        </view>

        <view class="meta-row" wx:if="{{item.occupation}}">
          <text class="meta-name">职业</text>
          <text class="meta-val">{{item.occupation}}</text>
        </view>

        <view class="meta-row" wx:if="{{item.isPublicSector}}">
          <text class="meta-name">体制内</text>
          <view class="meta-val">
            <text class="status-tag tag-sector">✓ 体制内单位</text>
          </view>
        </view>

        <view class="meta-row" wx:if="{{item.income}}">
          <text class="meta-name">收入</text>
          <text class="meta-val highlight">{{item.income}}</text>
        </view>

        <view class="meta-row" wx:if="{{item.socialAccount}}">
          <text class="meta-name">社交账号</text>
          <text class="meta-val">{{item.socialAccount}}</text>
        </view>

        <view class="meta-row" wx:if="{{item.phone}}">
          <text class="meta-name">联系电话</text>
          <text class="meta-val phone-text">{{item.phone}}</text>
        </view>
      </view>

      <!-- 个人备注 -->
      <view class="card-quote" wx:if="{{item.remark}}">
        <view class="quote-head">
          <text class="quote-tag">个人心语与要求</text>
        </view>
        <text class="quote-content">{{item.remark}}</text>
      </view>

      <!-- 照片画廊 -->
      <view class="card-photos" wx:if="{{item.images && item.images.length > 0}}">
        <view class="photos-grid">
          <image
            wx:for="{{item.images}}"
            wx:for-item="img"
            wx:key="*this"
            class="photo-thumb"
            src="{{img}}"
            mode="aspectFill"
            catchtap="onPreviewPhoto"
            data-src="{{img}}"
            data-urls="{{item.images}}"
          />
        </view>
      </view>
    </view>
  </view>
</view>
