/* pages/publish/publish.wxss */

.publish-page {
  min-height: 100vh;
  background-color: #f7f9fb;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 顶部轻量化标题栏与右上角操作区 */
.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid #edf2f7;
  padding: 24rpx 32rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.page-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1a202c;
  letter-spacing: -0.5rpx;
}

.page-count {
  font-size: 24rpx;
  color: #a0aec0;
  font-weight: 500;
}

/* 渐变小胶囊新增按钮 */
.btn-create {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ff5e62, #ff9966);
  color: #ffffff;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 14rpx rgba(255, 94, 98, 0.3);
  transition: all 0.15s ease;
}

.btn-create:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.icon-plus {
  font-size: 30rpx;
  font-weight: bold;
  margin-right: 6rpx;
  line-height: 1;
}

.btn-create-text {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

/* 主内容容器 */
.page-body {
  padding: 24rpx 24rpx 0;
}

/* 卡片流设计 */
.my-card {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

/* 顶部色彩饰条 */
.card-bar {
  height: 6rpx;
  width: 100%;
}

.my-card.gender-male .card-bar {
  background: linear-gradient(90deg, #3498db, #5dade2);
}

.my-card.gender-female .card-bar {
  background: linear-gradient(90deg, #e74c3c, #f1948a);
}

/* 卡片头部 */
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 18rpx;
  border-bottom: 1rpx solid #f8f9fa;
}

.head-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a202c;
}

.gender-pill {
  display: flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.pill-male {
  background: #ebf5fb;
  color: #2980b9;
}

.pill-female {
  background: #fdf2e9;
  color: #d35400;
}

.gender-symbol {
  font-size: 24rpx;
  margin-right: 4rpx;
  font-weight: bold;
}

.role-tag {
  font-size: 20rpx;
  color: #718096;
  background: #edf2f7;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 右上角操作胶囊 */
.head-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.btn-pill {
  padding: 8rpx 22rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.15s ease;
}

.btn-pill:active {
  transform: scale(0.95);
}

.btn-pill-edit {
  color: #e74c3c;
  background: #fff5f5;
  border: 1rpx solid #fed7d7;
}

.btn-pill-del {
  color: #718096;
  background: #f7fafc;
  border: 1rpx solid #e2e8f0;
}

/* 核心信息排列表 */
.card-meta-list {
  padding: 12rpx 28rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #edf2f7;
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-name {
  width: 110rpx;
  font-size: 24rpx;
  color: #a0aec0;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.meta-val {
  flex: 1;
  font-size: 26rpx;
  color: #2d3748;
  font-weight: 500;
}

.meta-val.num {
  font-weight: 600;
  color: #1a202c;
}

.meta-val.highlight {
  color: #dd6b20;
  font-weight: 600;
}

.meta-val.phone-text {
  color: #e53e3e;
  font-weight: 700;
  letter-spacing: 1.5rpx;
}

.status-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
}

.tag-house {
  background: #f0fdf4;
  color: #15803d;
  border: 1rpx solid #bbf7d0;
}

.tag-sector {
  background: #fef2f2;
  color: #b91c1c;
  border: 1rpx solid #fecaca;
  font-weight: 600;
}

/* 备注引用框 */
.card-quote {
  margin: 14rpx 28rpx 20rpx;
  padding: 18rpx 22rpx;
  background: #fafaf9;
  border-left: 6rpx solid #cbd5e1;
  border-radius: 8rpx;
}

.quote-head {
  margin-bottom: 8rpx;
}

.quote-tag {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
}

.quote-content {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
  word-break: break-all;
}

/* 照片网格 */
.card-photos {
  padding: 8rpx 28rpx 28rpx;
}

.photos-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-thumb {
  width: 154rpx;
  height: 154rpx;
  border-radius: 12rpx;
  background-color: #edf2f7;
}

/* 空状态 */
.empty-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 90rpx 40rpx;
  text-align: center;
  margin-top: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.empty-art {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2d3748;
  display: block;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #a0aec0;
  display: block;
  margin-bottom: 40rpx;
}

.btn-empty-action {
  background: linear-gradient(135deg, #ff5e62, #ff9966);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 16rpx 48rpx;
  display: inline-block;
  box-shadow: 0 6rpx 20rpx rgba(255, 94, 98, 0.35);
  border: none;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 60rpx 0;
}

.loading-text {
  font-size: 24rpx;
  color: #a0aec0;
}
